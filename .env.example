# ── Logging
LOG_LEVEL=info            # pino level: trace|debug|info|warn|error|fatal

# ── Backend
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
PORT=3000

# ── Database
DATABASE_URL=             # Postgres (postgresql://user:pass@host:port/db). Ver docs/RAG_SETUP.md
# Creá .env en la raíz del proyecto (junto a package.json).

# ── RAG / Postgres (Neon, AlloyDB, Docker)
RAG_DATABASE_URL=         # postgresql://user:pass@host/db?sslmode=require

# ── Frontend (exposed to browser via Vite)
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth)
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login

# === Scrapers ===

# ── Playwright / shared scraper config (consumido por todos los scrapers)
PLAYWRIGHT_HEADLESS=true              # false para abrir Chromium con head (debugging)
SCRAPER_TIMEOUT_MS=30000              # timeout por defecto para selectores y navegación
SCRAPER_USER_AGENT=                   # opcional: UA string custom; default "Mozilla/5.0 (compatible; LexTrack/1.0)"
SCRAPER_DEBUG=false                   # true para guardar screenshots cuando un scrape falla
SCRAPER_DEBUG_DIR=./debug             # carpeta destino para los screenshots de debug

# ── PJUD scraper
# "simulator" (default) usa datos sintéticos; "playwright" lanza Chromium real.
# Antes de usar "playwright" en prod hay que verificar los selectores en api/lib/pjud/playwright-scraper.ts
PJUD_SCRAPER=simulator

# ── DT (Dirección del Trabajo) scraper
# "simulator" (default) usa datos sintéticos; "playwright" lanza Chromium contra dt.gob.cl.
# Antes de usar "playwright" hay que verificar los selectores en api/lib/dt/playwright-scraper.ts
DT_SCRAPER=simulator

# ── BCN (Biblioteca del Congreso Nacional / LeyChile) scraper
# "simulator" (default) usa datos sintéticos; "playwright" lanza Chromium contra bcn.cl/leychile.
# Antes de usar "playwright" hay que verificar los selectores en api/lib/bcn/playwright-scraper.ts
BCN_SCRAPER=simulator

# ── Diario Oficial scraper
# "simulator" (default) usa datos sintéticos; "playwright" lanza Chromium real.
# Antes de usar "playwright" hay que verificar los selectores en api/lib/diariooficial/playwright-scraper.ts
DIARIO_OFICIAL_SCRAPER=simulator

# ── Corte Suprema scraper (jurisprudencia)
# "simulator" (default) usa datos sintéticos; "playwright" lanza Chromium real.
# Antes de usar "playwright" hay que verificar los selectores y la URL en api/lib/suprema/playwright-scraper.ts
SUPREMA_SCRAPER=simulator

# === Background Jobs ===

# ── Background jobs (cron)
JOBS_ENABLED=false # set true to run background scrapers/syncs

# ── RAG / IA (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-law-2
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Sentry (error tracking — disabled when empty)
SENTRY_DSN=
VITE_SENTRY_DSN=

# PostHog analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
# ── Transactional email (Resend)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=no-reply@lextrack.cl
